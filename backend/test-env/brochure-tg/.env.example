# 僅供本機簡章＋Telegram 隔離測試。不得沿用正式環境的帳密或 Bot token。

# Docker Compose 專用設定；所有服務只綁定 127.0.0.1。
BROCHURE_TG_TEST_POSTGRES_IMAGE=postgres:16-alpine
BROCHURE_TG_TEST_POSTGRES_PORT=55432
BROCHURE_TG_TEST_POSTGRES_USER=sta_brochure_tg_test
BROCHURE_TG_TEST_POSTGRES_PASSWORD=local-brochure-tg-test-only
BROCHURE_TG_TEST_POSTGRES_DB=sta_brochure_tg_test

BROCHURE_TG_TEST_RABBITMQ_IMAGE=rabbitmq:management-alpine
BROCHURE_TG_TEST_RABBITMQ_PORT=55672
BROCHURE_TG_TEST_RABBITMQ_MANAGEMENT_PORT=15673
BROCHURE_TG_TEST_RABBITMQ_USER=sta_brochure_tg_test
BROCHURE_TG_TEST_RABBITMQ_PASSWORD=local-brochure-tg-test-only

BROCHURE_TG_TEST_MINIO_IMAGE=minio/minio:latest
BROCHURE_TG_TEST_MINIO_MC_IMAGE=minio/mc:latest
BROCHURE_TG_TEST_MINIO_PORT=59000
BROCHURE_TG_TEST_MINIO_CONSOLE_PORT=59001
BROCHURE_TG_TEST_MINIO_ACCESS_KEY=sta_brochure_tg_test
BROCHURE_TG_TEST_MINIO_SECRET_KEY=local-brochure-tg-test-only
BROCHURE_TG_TEST_MINIO_BUCKET=sta-brochure-tg-test

BROCHURE_TG_TEST_CLAMAV_IMAGE=clamav/clamav:stable
BROCHURE_TG_TEST_CLAMAV_PORT=53310
BROCHURE_TG_TEST_CONSOLE_PORT=54173

# STA API：刻意使用 test 與非正式連接埠。
STA_ENV=test
STA_HTTP_ADDR=127.0.0.1:58080
STA_ALLOWED_ORIGINS=http://127.0.0.1:54173,http://localhost:54173
STA_PUBLIC_BASE_URL=http://127.0.0.1:58080
STA_DATABASE_URL=postgres://sta_brochure_tg_test:local-brochure-tg-test-only@127.0.0.1:55432/sta_brochure_tg_test?sslmode=disable

STA_RABBITMQ_URL=amqp://sta_brochure_tg_test:local-brochure-tg-test-only@127.0.0.1:55672/%2f
STA_EXTRACTION_TRANSPORT=rabbitmq
STA_RABBITMQ_EXCHANGE=sta.brochure-tg-test.events
STA_RABBITMQ_EXTRACT_QUEUE=sta.brochure-tg-test.admissions.extract
STA_RABBITMQ_RESULT_QUEUE=sta.brochure-tg-test.admissions.extracted

STA_OBJECT_STORAGE_ENDPOINT=127.0.0.1:59000
STA_OBJECT_STORAGE_ACCESS_KEY=sta_brochure_tg_test
STA_OBJECT_STORAGE_SECRET_KEY=local-brochure-tg-test-only
STA_OBJECT_STORAGE_BUCKET=sta-brochure-tg-test
STA_OBJECT_STORAGE_USE_SSL=false
STA_CLAMAV_ADDRESS=tcp://127.0.0.1:53310
STA_REQUIRE_FILE_SCAN=true

STA_REQUIRE_EDU_EMAIL=false
STA_REQUIRE_ADMIN_MFA=false
STA_EMAIL_ENCRYPTION_KEY=Y9tlc7DPezQvVl4SFHQAS92PbdW4DidPgAKN1cmFlk4=
STA_LOOKUP_HMAC_KEY=1iKNy9s6vLlK2/Japzi+nuhJbL2Nss2QTCXpa808RYk=
STA_SESSION_TTL=24h
STA_MAX_JSON_BODY_BYTES=2097152
STA_SHUTDOWN_TIMEOUT=10s

# 請使用獨立測試 Bot；勿填正式 Bot token。
STA_TELEGRAM_BOT_TOKEN=
STA_TELEGRAM_BACKEND_BASE_URL=http://127.0.0.1:58080
STA_TELEGRAM_API_BASE_URL=https://api.telegram.org
STA_TELEGRAM_BOT_ALLOWED_CHAT_IDS=
STA_TELEGRAM_POLL_TIMEOUT=25s

# 簡章探索與外部擷取 API 為選配；只測上傳、上架與 TG 讀取時可保持空白。
STA_EXTRACTION_SERVICE_TOKEN=
STA_BROCHURE_DISCOVERY_AGENT_TOKEN=
STA_BROCHURE_DISCOVERY_API_BASE_URL=http://127.0.0.1:58080
STA_BROCHURE_DISCOVERY_POLL_INTERVAL=30s
STA_BROCHURE_DISCOVERY_FETCH_TIMEOUT=30s
# 補上部分 .edu.tw 站台未附的 TWCA 中繼 CA；certs/ 內附一份。
STA_BROCHURE_DISCOVERY_CA_BUNDLE=
STA_SEARXNG_URL=http://127.0.0.1:58888
STA_SEARXNG_ENGINES=google,bing,duckduckgo
STA_SEARXNG_LANGUAGE=zh-TW
# Python extraction worker 使用同一組隔離 RabbitMQ 與 MinIO。
STA_WORKER_DOCUMENT_ROOT=
STA_WORKER_MAX_FILE_BYTES=52428800
STA_WORKER_PROCESSOR_VERSION=local-extraction-v1
STA_WORKER_OBJECT_STORAGE_ENDPOINT=127.0.0.1:59000
STA_WORKER_OBJECT_STORAGE_ACCESS_KEY=sta_brochure_tg_test
STA_WORKER_OBJECT_STORAGE_SECRET_KEY=local-brochure-tg-test-only
STA_WORKER_OBJECT_STORAGE_BUCKET=sta-brochure-tg-test
STA_WORKER_OBJECT_STORAGE_USE_SSL=false
