# 供 Telegram cross-check adapter 隔離驗收；cmd/api 會在設定 service token
# 並套用 -include-telegram migration 後掛載 adapter。
# 不得沿用正式資料庫、管理員帳密或 Bot token。

CROSS_CHECK_TG_TEST_POSTGRES_IMAGE=postgres:16-alpine
CROSS_CHECK_TG_TEST_POSTGRES_PORT=55436
CROSS_CHECK_TG_TEST_POSTGRES_USER=sta_cross_check_tg_test
CROSS_CHECK_TG_TEST_POSTGRES_PASSWORD=local-cross-check-tg-test-only
CROSS_CHECK_TG_TEST_POSTGRES_DB=sta_cross_check_tg_test

STA_ENV=test
STA_HTTP_ADDR=127.0.0.1:58082
STA_ALLOWED_ORIGINS=http://127.0.0.1:54175
STA_PUBLIC_BASE_URL=http://127.0.0.1:58082
STA_DATABASE_URL=postgres://sta_cross_check_tg_test:local-cross-check-tg-test-only@127.0.0.1:55436/sta_cross_check_tg_test?sslmode=disable

STA_RABBITMQ_URL=
STA_OBJECT_STORAGE_ENDPOINT=
STA_CLAMAV_ADDRESS=
STA_REQUIRE_FILE_SCAN=false
STA_REQUIRE_EDU_EMAIL=false
STA_REQUIRE_ADMIN_MFA=false
STA_EMAIL_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
STA_LOOKUP_HMAC_KEY=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=
STA_SESSION_TTL=24h
STA_MAX_JSON_BODY_BYTES=2097152
STA_SHUTDOWN_TIMEOUT=10s

# API 與測試 Bot 共用的內部服務 bearer；這不是 Telegram Bot token。
STA_TELEGRAM_CROSS_CHECK_TOKEN=local-cross-check-service-token-2026-change-before-sharing-folder
STA_TELEGRAM_CROSS_CHECK_ALLOW_TEST_PROVISIONING=true

# 請另外建立測試 Bot；留白時可先執行 API-only 驗收。
STA_TELEGRAM_BOT_TOKEN=
STA_TELEGRAM_BACKEND_BASE_URL=http://127.0.0.1:58082
STA_TELEGRAM_API_BASE_URL=https://api.telegram.org
STA_TELEGRAM_BOT_ALLOWED_CHAT_IDS=
STA_TELEGRAM_POLL_TIMEOUT=5s

# 只用於隔離資料庫的管理員帳號。正式環境不可使用這些值。
CROSS_CHECK_TEST_ADMIN_USERNAME=sta_crosscheck_admin
CROSS_CHECK_TEST_ADMIN_EMAIL=sta-crosscheck-admin@example.test
CROSS_CHECK_TEST_ADMIN_PASSWORD=LocalCrossCheckAdmin-2026!
