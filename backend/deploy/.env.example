# Copy to deploy/.env and adjust. Docker Compose auto-loads deploy/.env for both
# ${...} substitution in docker-compose.yml AND as the env_file for the app
# containers. This is a local / single-host stack — do NOT use these values in
# production; generate real keys and secrets.

# ── container environment (STA_* consumed by the Go binaries + Python worker) ──
STA_ENV=development
STA_HTTP_ADDR=:8080
STA_ALLOWED_ORIGINS=http://localhost:3000

STA_DATABASE_URL=postgres://sta:sta@postgres:5432/sta?sslmode=disable

STA_OBJECT_STORAGE_ENDPOINT=minio:9000
STA_OBJECT_STORAGE_ACCESS_KEY=sta-minio-root
STA_OBJECT_STORAGE_SECRET_KEY=sta-minio-secret
STA_OBJECT_STORAGE_BUCKET=sta-private
STA_OBJECT_STORAGE_USE_SSL=false

# RabbitMQ only for the compatibility extraction transport
# (docker compose --profile rabbitmq ...). Blank ⇒ HTTP claim transport.
STA_RABBITMQ_URL=
STA_RABBITMQ_EXCHANGE=sta.events
STA_RABBITMQ_EXTRACT_QUEUE=sta.admissions.extract
STA_RABBITMQ_RESULT_QUEUE=sta.admissions.extracted

STA_CLAMAV_ADDRESS=tcp://clamav:3310
STA_REQUIRE_FILE_SCAN=false

# MailHog captures mail locally; it speaks plain SMTP so TLS must be disabled.
STA_SMTP_HOST=mailhog
STA_SMTP_PORT=1025
STA_SMTP_FROM=no-reply@sta.local
STA_SMTP_USERNAME=
STA_SMTP_PASSWORD=
STA_SMTP_USE_TLS=false
# Cleartext SMTP is refused unless this is set; honored only when STA_ENV != production.
STA_SMTP_ALLOW_INSECURE=true

STA_PUBLIC_BASE_URL=http://localhost:8080
STA_MEILISEARCH_URL=http://meilisearch:7700
STA_MEILISEARCH_KEY=sta-local-meili-master-key
MEILI_MASTER_KEY=sta-local-meili-master-key
STA_SUPPORT_EMAIL=support@sta.local

# openssl rand -base64 32  — DEV ONLY
STA_EMAIL_ENCRYPTION_KEY=c3RhLWxvY2FsLWRldi1lbWFpbC1rZXktMDAwMDAwMDE=
STA_LOOKUP_HMAC_KEY=c3RhLWxvY2FsLWRldi1sb29rdXAtaG1hYy0wMDAwMDE=
# Optional AES key rotation (see deploy/README.md):
#   STA_FIELD_ENCRYPTION_KEYS=1:<base64>,2:<base64>
#   STA_FIELD_ENCRYPTION_PRIMARY_VERSION=2
STA_FIELD_ENCRYPTION_KEYS=
STA_FIELD_ENCRYPTION_PRIMARY_VERSION=
# Retired lookup-HMAC keys kept for reads during STA_LOOKUP_HMAC_KEY rotation.
STA_LOOKUP_HMAC_SECONDARY_KEYS=

STA_REQUIRE_ADMIN_MFA=false
# TOTP grant window: admin requests may omit X-MFA-Code within this long after
# a successful verify. 0 = require a code every request.
STA_ADMIN_MFA_GRANT_TTL=15m
STA_SESSION_TTL=720h
STA_SHUTDOWN_TIMEOUT=10s
STA_WORKER_HEALTH_ADDR=:9090
# OTLP/HTTP trace exporter. Blank = logs-only traceparent propagation.
STA_OTEL_EXPORTER_OTLP_ENDPOINT=
STA_OTEL_EXPORTER_OTLP_INSECURE=true
STA_OTEL_SERVICE_NAME=sta-backend
STA_OTEL_TRACES_SAMPLER_RATIO=1.0

STA_BROCHURE_DISCOVERY_AGENT_TOKEN=sta-local-discovery-agent-token-0000000000
STA_BROCHURE_DISCOVERY_API_BASE_URL=http://api:8080
STA_SEARXNG_URL=http://searxng:8080
STA_SEARXNG_ENGINES=google,bing,duckduckgo
STA_SEARXNG_LANGUAGE=zh-TW

STA_EXTRACTION_SERVICE_TOKEN=sta-local-extraction-service-token-000000000
STA_EXTRACTION_TRANSPORT=api
STA_EXTRACTION_API_BASE_URL=http://api:8080
STA_EXTRACTION_POLL_INTERVAL=5s
STA_WORKER_PROCESSOR_VERSION=local-extraction-v1
STA_WORKER_MAX_FILE_BYTES=52428800
STA_WORKER_OCR_ENABLED=true
STA_WORKER_OCR_LANG=chi_tra+eng
STA_WORKER_OCR_DPI=250
STA_WORKER_OCR_MIN_TEXT_CHARS=40
STA_WORKER_OCR_MAX_PAGES=300
STA_WORKER_OCR_TIMEOUT=120

# Cloudflare Workers AI brochure extraction. When enabled with credentials the
# python-worker sends the (locally extracted) PDF text to a Workers AI chat
# model and asks for the structured programme list; the rule-based parser stays
# as the fallback. Leave STA_WORKER_AI_ENABLED unset to keep the rule-based path.
STA_WORKER_AI_ENABLED=false
STA_WORKER_AI_ACCOUNT_ID=
STA_WORKER_AI_API_TOKEN=
STA_WORKER_AI_MODEL=@cf/mistralai/mistral-small-3.1-24b-instruct
STA_WORKER_AI_BASE_URL=https://api.cloudflare.com/client/v4
STA_WORKER_AI_TIMEOUT=120
STA_WORKER_AI_MAX_INPUT_CHARS=40000
STA_WORKER_AI_MAX_OUTPUT_TOKENS=3072
STA_WORKER_AI_MAX_CHUNKS=12
STA_WORKER_AI_CONFIDENCE=0.3

# optional integrations (blank ⇒ that worker/route stays disabled)
STA_DISCORD_CHAT_WEBHOOK_SECRET=
STA_TELEGRAM_CHAT_WEBHOOK_SECRET=
STA_DISCORD_CHAT_BOT_TOKEN=
STA_DISCORD_CHAT_CHANNEL_ID=
STA_TELEGRAM_BOT_TOKEN=
STA_TELEGRAM_CHAT_ID=
STA_TELEGRAM_CROSS_CHECK_TOKEN=

# ── consumed by docker-compose.yml itself (${...} substitution) ──────────────
POSTGRES_USER=sta
POSTGRES_PASSWORD=sta
POSTGRES_DB=sta
MINIO_ROOT_USER=sta-minio-root
MINIO_ROOT_PASSWORD=sta-minio-secret
RABBITMQ_DEFAULT_USER=sta
RABBITMQ_DEFAULT_PASS=sta

# ── Caddy (reverse proxy + static frontend) ───────────────────────────────
# Dev: ":80" makes Caddy listen on plain HTTP without attempting ACME/TLS.
# Prod: set to your domain (e.g. "sta-tw.org") to get automatic Let's Encrypt TLS.
STA_DOMAIN=:80
STA_ACME_EMAIL=
# Same-origin API calls from the static frontend (Caddy proxies /api/* to the
# api service on the same domain), so leave this blank for both dev and prod.
STA_FRONTEND_API_BASE_URL=

# host port bindings (all on 127.0.0.1) — change on collision
STA_COMPOSE_API_PORT=8080
STA_COMPOSE_POSTGRES_PORT=5432
STA_COMPOSE_MINIO_PORT=9000
STA_COMPOSE_MINIO_CONSOLE_PORT=9001
STA_COMPOSE_RABBITMQ_PORT=5672
STA_COMPOSE_RABBITMQ_MGMT_PORT=15672
STA_COMPOSE_MAILHOG_UI_PORT=8025
STA_COMPOSE_SEARXNG_PORT=8888
