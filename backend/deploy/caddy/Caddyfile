{
	# Cloudflare proxies (orange-cloud) still forward normal HTTP requests to
	# the origin, so the ACME HTTP-01 challenge below works with the Cloudflare
	# SSL/TLS mode set to "Full (strict)". Override STA_ACME_EMAIL for real
	# Let's Encrypt renewal notices.
	email {$STA_ACME_EMAIL}
	servers {
		# Only Cloudflare may provide the original visitor IP. Direct origin
		# requests use their socket address, even if they forge this header.
		trusted_proxies static 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 104.16.0.0/13 104.24.0.0/14 108.162.192.0/18 131.0.72.0/22 141.101.64.0/18 162.158.0.0/15 172.64.0.0/13 173.245.48.0/20 188.114.96.0/20 190.93.240.0/20 197.234.240.0/22 198.41.128.0/17 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
	}
}

{$STA_DOMAIN} {
	encode gzip zstd

	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The Go backend's own middleware already sets this for /api/* (see
		# internal/httpapi/middleware.go), but that only covers the reverse
		# proxy path below — the static frontend Caddy serves directly never
		# passed through it, so every plain page load was missing HSTS
		# entirely until this covered both paths at the edge.
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}

	@api path /api/* /healthz
	handle @api {
		reverse_proxy api:8080 {
			flush_interval -1
			header_up X-STA-Client-IP {client_ip}
		}
	}

	# Next.js embeds a content hash in every filename under /_next/static/,
	# so a given path's bytes never change — safe to cache for a year instead
	# of falling back to whatever default TTL the CDN/browser would otherwise
	# pick for a file with no explicit Cache-Control.
	@nextstatic path /_next/static/*
	header @nextstatic Cache-Control "public, max-age=31536000, immutable"

	# Static assets under public/ aren't content-hashed, so a deploy can change
	# their bytes at the same path — cache for a day rather than a year, and
	# purge the CDN cache after a deploy that changes one of these.
	@publicassets path /features/* /logo.svg /favicon.ico
	header @publicassets Cache-Control "public, max-age=86400"

	handle {
		root * /srv/frontend/current
		# No /404.html fallback here: that would make file_server "succeed" at
		# serving it with a 200 for literally any unmatched path, so a genuine
		# miss never reaches handle_errors below and every non-existent URL on
		# the whole site reports OK instead of 404 (bad for SEO/monitoring/
		# scanners, and papers over real broken links). Letting the miss
		# actually error here is what lets handle_errors serve the same
		# 404.html content while still reporting the real status code.
		try_files {path} {path}/
		file_server
	}

	handle_errors {
		@404 expression {http.error.status_code} == 404
		rewrite @404 /404.html
		file_server {
			root /srv/frontend/current
		}
	}
}

# No content of its own — this site block exists so Caddy obtains and renews
# a Let's Encrypt cert for the mail hostname; the postfix service reads the
# resulting cert/key straight out of the shared caddy-data volume.
{$STA_MAIL_HOSTNAME} {
	respond "mail relay for {$STA_DOMAIN}" 200
}

# Grafana itself has no host port published and no password login of its
# own — every request must first pass forward_auth, which asks the API
# whether the caller is already a logged-in STA admin (GET
# /api/v1/admin/grafana-auth). Only a 200 from that lets the request through,
# and its X-WEBAUTH-USER response header is copied onto the request Grafana
# receives, logging that same account straight in (see GF_AUTH_PROXY_* below
# in docker-compose.yml). Any X-WEBAUTH-USER the client itself tried to send
# is stripped first so it can't spoof an identity that way.
#
# Wrapped in `route` because Caddy otherwise reorders directives by its own
# fixed priority list instead of the order written here — without it,
# request_header's delete was compiled to run AFTER forward_auth despite
# being written before it, wiping out the trusted header forward_auth had
# just set and leaving Grafana with no identity at all.
{$STA_GRAFANA_HOSTNAME} {
	route {
		request_header -X-WEBAUTH-USER
		reverse_proxy api:8080 {
			# This is a server-side auth check, not a browser CORS request.
			# Keep the browser's Origin away from the API CORS middleware.
			method GET
			rewrite /api/v1/admin/grafana-auth
			header_up -Origin
			header_up X-Forwarded-Method {method}
			header_up X-Forwarded-Uri {uri}

			@grafanaAuthGranted status 2xx
			handle_response @grafanaAuthGranted {
				request_header X-WEBAUTH-USER {rp.header.X-WEBAUTH-USER}
			}
		}
		reverse_proxy grafana:3000
	}
}

# Public entry point for object storage. MinIO itself is bound to
# 127.0.0.1 only and never exposed directly; every request here still needs
# a valid presigned-URL signature (set STA_OBJECT_STORAGE_PUBLIC_ENDPOINT to
# this hostname so the backend signs download links against it instead of
# the internal minio:9000 service name, which a browser can't resolve).
{$STA_OBJECT_STORAGE_PUBLIC_HOSTNAME} {
	reverse_proxy minio:9000
}
