{
  "id": null,
  "uid": "sta-api-overview",
  "title": "STA API",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request rate by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "sum by (route) (rate(sta_http_requests_total[5m]))", "legendFormat": "{{route}}", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "Error rate (4xx/5xx) by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "sum by (route) (rate(sta_http_requests_total{status=~\"4..|5..\"}[5m]))", "legendFormat": "{{route}}", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "title": "p95 latency by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (route, le) (rate(sta_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "Total request rate",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "sum(rate(sta_http_requests_total[5m]))", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "title": "Goroutines",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "go_goroutines{job=\"api\"}", "refId": "A" }
      ]
    }
  ]
}
