#!/bin/sh
# Postfix's pipe(8) transport feeds the raw RFC 5322 message on stdin, and
# (see master.cf) the envelope recipient as $1 — forwarded as a header so
# the API knows which mail_routes row this delivery matched, without having
# to re-derive it from the (possibly different) To: header in the message
# itself. The message body is forwarded as-is; the API does its own MIME
# parsing.
exec curl -fsS --max-time 20 \
    -H "Authorization: Bearer __STA_ACCOUNT_APPLICATION_MAIL_TOKEN__" \
    -H "Content-Type: message/rfc822" \
    -H "X-STA-Recipient: ${1:-}" \
    --data-binary @- \
    "http://api:8080/api/v1/internal/mail-intake"
