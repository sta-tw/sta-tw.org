STA_ENV=development
STA_HTTP_ADDR=:8080
STA_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4173
STA_DATABASE_URL=
STA_RABBITMQ_URL=
STA_RABBITMQ_EXCHANGE=sta.events
STA_RABBITMQ_EXTRACT_QUEUE=sta.admissions.extract
STA_RABBITMQ_RESULT_QUEUE=sta.admissions.extracted
STA_OBJECT_STORAGE_ENDPOINT=
STA_OBJECT_STORAGE_ACCESS_KEY=
STA_OBJECT_STORAGE_SECRET_KEY=
STA_OBJECT_STORAGE_BUCKET=sta-private
STA_OBJECT_STORAGE_USE_SSL=false
# tcp://clamav:3310 or unix:///var/run/clamav/clamd.ctl; required in production when file storage is enabled.
STA_CLAMAV_ADDRESS=
STA_REQUIRE_FILE_SCAN=true
STA_DISCORD_CHAT_WEBHOOK_SECRET=
STA_TELEGRAM_CHAT_WEBHOOK_SECRET=
STA_DISCORD_CHAT_BOT_TOKEN=
STA_DISCORD_CHAT_CHANNEL_ID=
STA_SUPPORT_EMAIL=
STA_SUPPORT_EMAIL_WEBHOOK_SECRET=
STA_DISCORD_SUPPORT_WEBHOOK_SECRET=
# If empty, the support worker reuses STA_DISCORD_CHAT_BOT_TOKEN.
STA_DISCORD_SUPPORT_BOT_TOKEN=
STA_DISCORD_SUPPORT_GUILD_ID=
STA_DISCORD_SUPPORT_CATEGORY_ID=
STA_DISCORD_SUPPORT_ARCHIVE_CATEGORY_ID=
STA_DISCORD_SUPPORT_ROLE_ID=
STA_TELEGRAM_BOT_TOKEN=
STA_TELEGRAM_CHAT_ID=
# Optional Telegram cross-check adapter. When set, cmd/api mounts the
# Telegram cross-check routes; the core result API remains usable without it.
STA_TELEGRAM_CROSS_CHECK_TOKEN=
STA_TELEGRAM_CROSS_CHECK_ALLOW_TEST_PROVISIONING=false
# Telegram-only brochure smoke bot; it uses long polling and does not require a public webhook.
STA_TELEGRAM_BACKEND_BASE_URL=http://localhost:8080
STA_TELEGRAM_API_BASE_URL=https://api.telegram.org
STA_TELEGRAM_BOT_ALLOWED_CHAT_IDS=
STA_TELEGRAM_POLL_TIMEOUT=25s
STA_SMTP_HOST=
STA_SMTP_PORT=587
STA_SMTP_USERNAME=
STA_SMTP_PASSWORD=
STA_SMTP_FROM=
STA_SMTP_USE_TLS=true
STA_PUBLIC_BASE_URL=http://localhost:8080
# Optional Meilisearch full-text search. Blank disables GET /api/v1/search.
STA_MEILISEARCH_URL=
STA_MEILISEARCH_KEY=
# Authenticated API used by the external Python local-extraction worker and
# optional external search/AI agents that submit original files.
STA_EXTRACTION_SERVICE_TOKEN=
# Compatibility alias: STA_EXTERNAL_INGESTION_TOKEN=
STA_BROCHURE_DISCOVERY_AGENT_TOKEN=
STA_BROCHURE_DISCOVERY_API_BASE_URL=http://localhost:8080
STA_BROCHURE_DISCOVERY_POLL_INTERVAL=30s
# Self-hosted SearXNG endpoint for brochure discovery; JSON results must be enabled.
STA_SEARXNG_URL=http://localhost:8888
STA_SEARXNG_ENGINES=google,bing,duckduckgo
STA_SEARXNG_LANGUAGE=zh-TW
# Optional PEM bundle of extra CA certificates for the discovery fetcher. Some
# .edu.tw sites serve an incomplete chain (missing the TWCA intermediate); point
# this at a bundle containing it. Normal certificate validation still applies;
# the fetcher only relaxes Python 3.13's strict X.509 extension checks.
STA_BROCHURE_DISCOVERY_CA_BUNDLE=
# Only controls the domain check during account registration; it does not restrict support or notification recipients.
# Production defaults to true; set explicitly in other environments when needed.
STA_REQUIRE_EDU_EMAIL=false
# Production defaults to true. Admin API requests require X-MFA-Code after enrollment.
STA_REQUIRE_ADMIN_MFA=true
# Generate with: openssl rand -base64 32
STA_EMAIL_ENCRYPTION_KEY=
STA_LOOKUP_HMAC_KEY=
STA_SESSION_TTL=720h
STA_MAX_JSON_BODY_BYTES=2097152
STA_SHUTDOWN_TIMEOUT=10s
# Optional health/readiness HTTP endpoint for the port-less Go workers (chat/
# notification/support/ingestion). Blank disables it.
STA_WORKER_HEALTH_ADDR=
STA_WORKER_DOCUMENT_ROOT=
STA_WORKER_MAX_FILE_BYTES=52428800
STA_WORKER_PROCESSOR_VERSION=local-extraction-v1
STA_EXTRACTION_TRANSPORT=api
STA_EXTRACTION_API_BASE_URL=http://localhost:8080
STA_EXTRACTION_API_TIMEOUT=60s
STA_EXTRACTION_POLL_INTERVAL=5s
STA_WORKER_OBJECT_STORAGE_ENDPOINT=
STA_WORKER_OBJECT_STORAGE_ACCESS_KEY=
STA_WORKER_OBJECT_STORAGE_SECRET_KEY=
STA_WORKER_OBJECT_STORAGE_BUCKET=sta-private
STA_WORKER_OBJECT_STORAGE_USE_SSL=false
